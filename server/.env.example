# Local MongoDB, or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/uedi
# Use a long random string in production (at least 32 characters), e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Python ML service (ml-service/)
ML_SERVICE_URL=http://127.0.0.1:8000
# Gmail account that sends the verification codes for new accounts. Use a Google App Password
# (Google Account > Security > 2-Step Verification > App passwords), never the account password.
# Left empty in development, the code is printed in the server console instead.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional display sender, e.g. "UEDI Loans <uedi.loans@gmail.com>"
MAIL_FROM=
