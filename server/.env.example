# Local MongoDB, or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/uedi
# Use a long random string in production (at least 32 characters), e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Python ML service (ml-service/)
ML_SERVICE_URL=http://127.0.0.1:8000
# Gmail account that sends the verification codes for new accounts. Use a Google App Password
# (Google Account > Security > 2-Step Verification > App passwords), never the account password.
# Left empty in development, the code is printed in the server console instead.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# On Render's FREE tier the SMTP ports are blocked, so Gmail can't send from there. Use Brevo's
# email API instead (brevo.com, free plan): create an API key under SMTP & API > API Keys and
# verify your sender address under Senders. When BREVO_API_KEY is set it is used instead of Gmail.
BREVO_API_KEY=
# Sender shown on the email, e.g. "UDEI Loans <udei.loans@gmail.com>". Optional with Gmail,
# required with Brevo (must be a sender verified in Brevo).
MAIL_FROM=
